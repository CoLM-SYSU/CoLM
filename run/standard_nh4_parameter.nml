&nl_colm_solute_parameter
    ! ------------------------------------------------------------------
    ! Dissolved ammonium nitrogen, a solute in the material transport.
    !
    !   &nl_colm_material
    !      DEF_SOLUTE_NAMES       = 'NH4'
    !      DEF_SOLUTE_PARAM_FILES = 'NH4:run/standard_nh4_parameter.nml'
    !   /
    !
    ! Tracked mass is kg N per kg water (dilute water: mg N/L divided by
    ! 1.0e6).  With BGC compiled and run, the soil leaching flux that BGC
    ! already removes from the mineral-N pool is booked as an external
    ! solute input by MOD_MT_NitrogenLeaching:
    !   * nitrification ON : BGC leaches NO3 only, so NH4 receives no
    !     leaching input (BGC treats NH4 as immobile when DEF_USE_NITRIF);
    !   * nitrification OFF: the mineral-N pool is NH4, so sminn_leached_vr
    !     is booked to NH4.
    ! BGC files are not modified by this coupling.
    !
    ! Without BGC the species moves conservatively with precipitation and
    ! the configured initial concentration only.
    !
    ! Default rain concentration: 0.05 mg N/L, a commonly used background
    ! for ammonium in precipitation.  It is a tunable default, not a value
    ! derived for a specific station or period.  No practical solubility
    ! limit is set; ion exchange, nitrification and plant uptake are not
    ! modelled here (they belong to BGC).
    !
    ! NH4 leaching in BGC: enabled automatically when 'NH4' appears in
    ! DEF_SOLUTE_NAMES (DEF_NH4_LEACHING = 'auto', the default).  Set
    ! DEF_NH4_LEACHING = 'off' in &nl_colm_material to disable it, or
    ! 'on' to force it.  The BGC files are unchanged when it is off.
    !
    ! Indirect N2O: DEF_SOLUTE%n2o_ef5 below sets this solute's factor
    ! [kg N2O-N per kg N reaching the river]; a non-negative
    ! DEF_MT_N2O_EF5_NH4 in &nl_colm_material overrides it (0 turns the
    ! conversion off for this solute).  The conversion
    ! is applied once, at the land-to-river entry, and the
    ! removed nitrogen leaves to the atmosphere as N2O-N (the water is
    ! unchanged, so the river mass balance stays closed).  Reference values
    ! (IPCC 2019 Refinement, Vol. 4 Ch. 11, Table 11.3):
    !   EF5g = 0.006  groundwater / surface drainage
    !   EF5r = 0.0025 rivers
    !   EF5e = 0.0025 estuaries            total EF5 = 0.011
    ! The 2006 Guidelines used a single EF5 = 0.0075 (each component 0.0025).
    ! Tian, Cai & Akiyama (2019), Environ. Pollut. 245:300-306, a 254-
    ! measurement meta-analysis: groundwater/springs 0.0079, surface
    ! drainage 0.0040, lakes/ponds/reservoirs 0.0012, rivers 0.0030.
    ! Maavara et al. (2019), Glob. Change Biol. 25:473-488 simulate
    ! nitrification/denitrification with water residence time and conclude
    ! the IPCC factors may overestimate inland-water N2O by up to an order
    ! of magnitude; river N2O is mostly denitrification-derived, while
    ! reservoirs/estuaries are nitrification-dominated.  A single factor
    ! cannot represent that partition.
    !
    ! Method caveat: applying EF5 at the entry is the standard inventory
    ! arithmetic (N_leached x EF5), not a mechanistic water-body model.  It
    ! does not represent where in the network the emission occurs or how
    ! long the water resides, and it must not be applied again along the
    ! river.  Suggested use: start with the river component (0.0025) and
    ! run 0.006 / 0.011 as sensitivity bounds; 0 disables the conversion
    ! and leaves results bit-identical.
    ! ------------------------------------------------------------------
    DEF_SOLUTE%unit_kind           = 'mass_fraction'
    DEF_SOLUTE%mol_weight          = 14.007    ! kg N per mole of tracked N
    DEF_SOLUTE%init_conc           = 0.0       ! [kg N / kg water]
    DEF_SOLUTE%precip_default_conc = 5.0e-8    ! 0.05 mg N/L
    DEF_SOLUTE%vapor_default_conc  = 0.0
    DEF_SOLUTE%max_dissolved_conc  = 1.0       ! no practical limit
    DEF_SOLUTE%decay_rate          = 0.0       ! first-order loss [1/s]
    DEF_SOLUTE%n2o_ef5             = 2.5e-3    ! river component (IPCC 2019 EF5r); 0 disables
    DEF_SOLUTE%charge              = 1
/
