&nl_colm

! Author: Zhongwang Wei
! Description : grid-based river-lake flow (GridRiverLakeFlow, built when CaMa_Flood
!               is not defined) on the 15 min unit-catchment network, with
!               bifurcation channels, levees, reservoirs and two-way flood coupling.

   DEF_CASE_NAME = 'Amazon_Grid_25km_IGBP_VG_RiverLake'

   DEF_domain%edges = -20.0
   DEF_domain%edgen =   6.0
   DEF_domain%edgew = -80.0
   DEF_domain%edgee = -45.0

   DEF_simulation_time%greenwich    = .TRUE.
   DEF_simulation_time%start_year   = 2005
   DEF_simulation_time%start_month  = 1
   DEF_simulation_time%start_day    = 1
   DEF_simulation_time%start_sec    = 0
   DEF_simulation_time%end_year     = 2010
   DEF_simulation_time%end_month    = 12
   DEF_simulation_time%end_day      = 31
   DEF_simulation_time%end_sec      = 86400
   DEF_simulation_time%spinup_year  = 2005
   DEF_simulation_time%spinup_month = 1
   DEF_simulation_time%spinup_day   = 1
   DEF_simulation_time%spinup_sec   = 0
   DEF_simulation_time%spinup_repeat = 0

   DEF_simulation_time%timestep     = 1800.

   DEF_dir_rawdata = '/path/to/CoLMrawdata/'
   DEF_dir_runtime = '/path/to/CoLMruntime/'
   DEF_dir_output  = '/path/to/cases/'

   ! ----- land units and land sets -----
   ! for GRIDBASED
   DEF_GRIDBASED_lon_res = 0.25
   DEF_GRIDBASED_lat_res = 0.25

   ! LAI setting
   DEF_LAI_MONTHLY = .true.
   DEF_LAI_CHANGE_YEARLY = .false.

   ! ----- river-lake flow -----
   ! 15 min unit-catchment network; it also holds the bifurcation (bifurcation_*),
   ! levee (levee_frc, levee_hgt) and reservoir parameters.
   DEF_UnitCatchment_file = '/path/to/CoLMruntime/unitcatchment/grid_routing_data_15min.nc'

   ! Route only the river systems that the land domain covers. mkinidata writes the
   ! cut network to <DEF_dir_output>/<case>/riverlake/unitcatchment_regional.nc; rerun
   ! mkinidata (not mksrfdata) after switching. With LULCC it keeps the river systems
   ! of the land patches of every land-cover year from the start to the end year.
   DEF_UnitCatchment_regional = .true.

   ! reservoirs: 0 = off, 1 = Funato, 2 = H22 (CaMa-Flood PR124 implementation).
   ! H22 additionally requires dam_upreal [km2] in DEF_ReservoirPara_file.
   DEF_Reservoir_Method   = 1
   DEF_ReservoirPara_file = '/path/to/CoLMruntime/unitcatchment/grid_routing_data_15min.nc'

   DEF_USE_BIFURCATION = .true.
   DEF_USE_LEVEE       = .true.

   ! Two-way coupling: the flooded area feeds back to the land surface (evaporation
   ! and re-infiltration of floodwater). It sets DEF_Runoff_SCHEME = 0 (TOPMODEL with
   ! baseflow; rerun mksrfdata and mkinidata after switching).
   DEF_GridRiverLake_FloodFeedback = .true.

   ! For water-budget studies use the dynamic lake: the static default books lake
   ! evaporation shortfalls as lake_deficit and never repays them.
   ! DEF_USE_Dynamic_Lake = .true.

   ! ----- forcing -----
   ! Options :
   ! PRINCETON | GSWP3   | QIAN  | CRUNCEPV4 | CRUNCEPV7 | ERA5LAND | ERA5  | MSWX
   ! WFDE5     | CRUJRA  | WFDEI | JRA55     | GDAS      | CMFD     | POINT | JRA3Q
   DEF_forcing_namelist = '/path/to/CoLM/run/forcing/JRA3Q.nml'

   ! ----- history -----
   DEF_hist_lon_res = 0.25
   DEF_hist_lat_res = 0.25
   DEF_WRST_FREQ = 'MONTHLY' ! write restart file frequency: HOURLY/DAILY/MONTHLY/YEARLY
   DEF_HIST_FREQ = 'DAILY'   ! write history file frequency: HOURLY/DAILY/MONTHLY/YEARLY
   DEF_HIST_groupby = 'MONTH' ! history in one file: DAY/MONTH/YEAR

/
